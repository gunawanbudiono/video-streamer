<!-- 6. ACTIVITY & AUDIT LOGS MODAL -->
<div id="activityLogsModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div id="activityLogsDialog" class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-4xl w-full p-6 space-y-4 transform transition-all scale-95 opacity-0 flex flex-col max-h-[85vh]">
    <div class="flex items-center justify-between border-b border-dark-700 pb-4 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
          <i class="ti ti-history text-xl"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            System Activity & Audit Logs
            <span class="text-[10px] bg-blue-500/20 text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded-full font-mono">Live Audit Trail</span>
          </h3>
          <p class="text-xs text-gray-400">Real-time log of user, stream, media, and admin actions with exact timestamps</p>
        </div>
      </div>
      <button type="button" onclick="closeActivityLogsModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors"><i class="ti ti-x text-lg"></i></button>
    </div>

    <!-- Log Filters & Search Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-dark-900/80 p-3 rounded-xl border border-dark-700/60 shrink-0">
      <div class="relative w-full sm:w-72">
        <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
        <input type="text" id="logSearchInput" onkeyup="debounceLogSearch()" placeholder="Search log descriptions or users..." class="w-full bg-dark-950 border border-dark-700 rounded-lg pl-9 pr-3 py-1.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-blue-500" />
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <select id="logCategoryFilter" onchange="fetchActivityLogs()" class="bg-dark-950 border border-dark-700 rounded-lg px-3 py-1.5 text-xs text-gray-300 focus:outline-none focus:border-blue-500">
          <option value="all">All Categories</option>
          <option value="AUTH">Authentication & Impersonate</option>
          <option value="USER">User Management</option>
          <option value="STREAM">Stream Lifecycle</option>
          <option value="GALLERY">Gallery & Media</option>
          <option value="PLAYLIST">Playlists</option>
          <option value="ROTATION">Rotations</option>
        </select>
        <button type="button" onclick="fetchActivityLogs()" class="px-3 py-1.5 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-lg border border-dark-600 transition-all flex items-center gap-1 cursor-pointer">
          <i class="ti ti-refresh text-xs"></i> Refresh
        </button>
      </div>
    </div>

    <!-- Log Rows List Container -->
    <div id="activityLogsListContainer" class="overflow-y-auto space-y-2 pr-1 flex-1 min-h-[300px]">
      <div class="text-center py-12 text-gray-500 text-xs flex items-center justify-center gap-2">
        <i class="ti ti-loader animate-spin text-base"></i> Loading activity logs...
      </div>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between pt-3 border-t border-dark-700 text-xs text-gray-400 shrink-0">
      <span id="logCountBadge" class="font-mono text-[11px]">Showing recent audit events</span>
      <button type="button" onclick="closeActivityLogsModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl transition-all cursor-pointer">Close</button>
    </div>
  </div>
</div>

<!-- Dynamic Cache Buster Script -->
<script src="/js/users-management.js?v=<%= Date.now() %>"></script>
