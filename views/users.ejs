<div class="p-6 space-y-6">
  <!-- Top Header Section -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">User Management</h1>
      <p class="text-sm text-gray-400 mt-1">Manage user accounts, disk quotas, and permissions</p>
    </div>
    <button type="button" onclick="openCreateModal()" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-lg shadow-blue-600/20 transition-all flex items-center justify-center space-x-2 cursor-pointer">
      <i class="ti ti-user-plus text-lg"></i>
      <span>Create New User</span>
    </button>
  </div>

  <!-- Filters & Search Bar -->
  <div class="bg-dark-800 border border-dark-700/80 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="relative w-full md:w-80">
      <i class="ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-base"></i>
      <input type="text" id="searchInput" placeholder="Search users by name..." class="w-full bg-dark-900 border border-dark-700 rounded-xl pl-10 pr-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-all" />
    </div>
    <div class="flex items-center space-x-3 w-full md:w-auto justify-end">
      <select id="roleFilter" class="bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-gray-300 focus:outline-none focus:border-blue-500 transition-all">
        <option value="">All Roles</option>
        <option value="admin">Admin</option>
        <option value="member">Member</option>
      </select>
      <select id="statusFilter" class="bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-gray-300 focus:outline-none focus:border-blue-500 transition-all">
        <option value="">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
      </select>
    </div>
  </div>

  <!-- Users Table Container -->
  <div class="bg-dark-800 border border-dark-700/80 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-dark-900/60 border-b border-dark-700/80 text-xs font-semibold text-gray-400 uppercase tracking-wider">
            <th class="px-6 py-4">User</th>
            <th class="px-6 py-4">Role</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4">Video</th>
            <th class="px-6 py-4">Streaming</th>
            <th class="px-6 py-4">Created</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-dark-700/60 text-sm text-gray-300">
          <% if (users && users.length > 0) { %>
            <% users.forEach(user => { %>
              <tr class="user-row hover:bg-dark-700/30 transition-colors" data-username="<%= user.username.toLowerCase() %>" data-role="<%= user.user_role %>" data-status="<%= user.status %>">
                <!-- User Info -->
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center space-x-3">
                    <img src="<%= user.avatar_path || '/images/default-avatar.png' %>" alt="<%= user.username %>" class="w-10 h-10 rounded-full object-cover border border-dark-700" onerror="this.src='/images/default-avatar.png'" />
                    <div>
                      <p class="font-semibold text-white"><%= user.username %></p>
                      <p class="text-xs text-gray-500 font-mono">ID: <%= user.id %></p>
                    </div>
                  </div>
                </td>
                <!-- Role Badge -->
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2.5 py-1 text-xs font-medium rounded-full <%= user.user_role === 'admin' ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' : 'bg-blue-500/10 text-blue-400 border border-blue-500/20' %>">
                    <%= user.user_role %>
                  </span>
                </td>
                <!-- Status Badge -->
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2.5 py-1 text-xs font-medium rounded-full <%= user.status === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %>">
                    <%= user.status %>
                  </span>
                </td>
                <!-- Video Usage -->
                <td class="px-6 py-4 whitespace-nowrap cursor-pointer hover:bg-dark-700/50 transition-colors rounded-xl" data-action="view-videos" data-user-id="<%= user.id %>" data-username="<%= user.username %>">
                  <div class="flex flex-col">
                    <span class="text-xs text-gray-300 font-medium flex items-center gap-1"><i class="ti ti-video text-blue-400"></i> <%= user.videoCount || 0 %> video</span>
                    <span class="text-xs text-gray-500"><%= user.totalVideoSize || '0 B' %></span>
                  </div>
                </td>
                <!-- Stream Stats -->
                <td class="px-6 py-4 whitespace-nowrap cursor-pointer hover:bg-dark-700/50 transition-colors rounded-xl" data-action="view-streams" data-user-id="<%= user.id %>" data-username="<%= user.username %>">
                  <div class="flex flex-col">
                    <span class="text-xs text-gray-300 font-medium flex items-center gap-1"><i class="ti ti-broadcast text-red-400"></i> <%= user.streamCount || 0 %> stream</span>
                    <span class="text-xs text-emerald-400 font-medium"><%= user.activeStreamCount || 0 %> online</span>
                  </div>
                </td>
                <!-- Created Date -->
                <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-400">
                  <%= new Date(user.created_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </td>
                <!-- Actions Buttons (Text-Based Buttons: Detail & Impersonate) -->
                <td class="px-6 py-4 whitespace-nowrap text-right font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <!-- Detail Button (Opens Edit & Delete Modal) -->
                    <button type="button" data-action="edit" data-user-id="<%= user.id %>" data-username="<%= user.username %>" data-role="<%= user.user_role %>" data-status="<%= user.status %>" data-avatar="<%= user.avatar_path || '' %>" data-disk-limit="<%= user.disk_limit || 0 %>" class="px-3 py-1.5 bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 text-xs font-semibold rounded-lg transition-all flex items-center gap-1 cursor-pointer" title="View Detail & Edit">
                      <i class="ti ti-info-circle text-sm"></i>
                      <span>Detail</span>
                    </button>
                    
                    <!-- Impersonate Button (Text Button, Hidden for Logged-In User) -->
                    <% if (user.id !== req.session.userId) { %>
                      <button type="button" data-action="impersonate" data-user-id="<%= user.id %>" data-username="<%= user.username %>" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-semibold rounded-lg transition-all flex items-center gap-1 cursor-pointer" title="Login as Member">
                        <i class="ti ti-user-check text-sm"></i>
                        <span>Impersonate</span>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr id="defaultEmptyState">
              <td colspan="7" class="px-6 py-12 text-center text-gray-400">
                <i class="ti ti-users text-4xl mb-2 text-gray-500"></i>
                <p class="text-sm">No users found</p>
              </td>
            </tr>
          <% } %>
          <tr id="searchEmptyState" class="hidden">
            <td colspan="7" class="px-6 py-12 text-center text-gray-400">
              <i class="ti ti-search-off text-4xl mb-2 text-gray-500"></i>
              <p class="text-sm">No matching users found</p>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL OVERLAYS (CLEAN STRUCTURE)          -->
<!-- ========================================== -->

<!-- 1. DEDICATED IMPERSONATE CONFIRMATION MODAL -->
<div id="impersonateConfirmModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[999] hidden items-center justify-center p-4 transition-all">
  <div class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
        <i class="ti ti-user-check text-2xl"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white">Impersonate Member</h3>
        <p class="text-xs text-gray-400">Log in and view dashboard as member</p>
      </div>
    </div>
    <div class="bg-dark-900/60 border border-dark-700/80 rounded-xl p-4 text-sm text-gray-300">
      Are you sure you want to log in as member <strong id="impersonateTargetUsername" class="text-amber-400 font-bold text-base">""</strong>?
    </div>
    <div class="flex items-center justify-end gap-3 pt-2">
      <button type="button" onclick="closeImpersonateModal()" class="px-4 py-2.5 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl transition-all cursor-pointer">Cancel</button>
      <button type="button" id="confirmImpersonateSubmitBtn" onclick="submitImpersonate()" class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-dark-950 text-xs font-bold rounded-xl shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2 cursor-pointer">
        <i class="ti ti-user-check text-base"></i> Confirm Login
      </button>
    </div>
  </div>
</div>

<!-- 2. EDIT USER MODAL (INCLUDES USER DETAIL & DELETE USER OPTION) -->
<div id="editModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-4">
      <div>
        <h3 class="text-lg font-bold text-white">User Details & Settings</h3>
        <p class="text-xs text-gray-400 mt-0.5">Edit user profile, permissions, or delete user</p>
      </div>
      <button type="button" onclick="closeEditModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors"><i class="ti ti-x text-lg"></i></button>
    </div>
    <form id="editUserForm" class="space-y-4">
      <input type="hidden" id="editUserId" name="userId" />
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Username</label>
        <input type="text" id="editUsername" name="username" required class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Role</label>
          <select id="editRole" name="role" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Status</label>
          <select id="editStatus" name="status" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Disk Quota Limit (MB)</label>
        <input type="number" id="editDiskLimit" name="diskLimit" min="0" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>

      <!-- Action Footer: Save Changes + Danger Zone Delete User Button -->
      <div class="flex items-center justify-between pt-4 border-t border-dark-700">
        <!-- Delete User Button (Danger Action Inside Edit Modal) -->
        <button type="button" id="deleteFromEditModalBtn" onclick="triggerDeleteFromEditModal()" class="px-3.5 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-semibold rounded-xl transition-all flex items-center gap-1.5 cursor-pointer">
          <i class="ti ti-trash text-sm"></i>
          <span>Delete User</span>
        </button>

        <div class="flex items-center space-x-2">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-600/20">Save Changes</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- 3. CREATE USER MODAL -->
<div id="createModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-4">
      <h3 class="text-lg font-bold text-white">Create New User</h3>
      <button type="button" onclick="closeCreateModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors"><i class="ti ti-x text-lg"></i></button>
    </div>
    <form id="createUserForm" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Username</label>
        <input type="text" name="username" required class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Password</label>
        <input type="password" name="password" required class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Role</label>
          <select name="role" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Disk Quota (MB)</label>
          <input type="number" name="diskLimit" value="10240" min="0" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
        </div>
      </div>
      <div class="flex items-center justify-end space-x-3 pt-3 border-t border-dark-700">
        <button type="button" onclick="closeCreateModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl">Cancel</button>
        <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-600/20">Create User</button>
      </div>
    </form>
  </div>
</div>

<!-- 4. CONFIRMATION MODAL -->
<div id="confirmModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-3">
      <h3 id="modalTitle" class="text-base font-bold text-white">Confirm Action</h3>
      <button type="button" onclick="closeModal()" class="text-gray-400 hover:text-white p-1"><i class="ti ti-x"></i></button>
    </div>
    <p id="modalMessage" class="text-sm text-gray-300">Are you sure you want to perform this action?</p>
    <div class="flex items-center justify-end space-x-3 pt-2">
      <button type="button" onclick="closeModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl">Cancel</button>
      <button type="button" id="confirmButton" class="px-5 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-rose-600/20">Confirm</button>
    </div>
  </div>
</div>

<!-- 5. VIDEO COLLECTION MODAL -->
<div id="videoModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-2xl w-full p-6 space-y-4 transform transition-all scale-95 opacity-0 max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between border-b border-dark-700 pb-3">
      <h3 id="videoModalTitle" class="text-base font-bold text-white">Video Collection</h3>
      <button type="button" onclick="closeVideoModal()" class="text-gray-400 hover:text-white p-1"><i class="ti ti-x"></i></button>
    </div>
    <div id="videoList" class="space-y-3 overflow-y-auto pr-1 flex-1"></div>
    <div id="videoModalEmptyState" class="hidden text-center py-8 text-gray-400"><p class="text-sm">No videos uploaded by this user</p></div>
  </div>
</div>

<!-- 6. STREAM COLLECTION MODAL -->
<div id="streamModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-2xl w-full p-6 space-y-4 transform transition-all scale-95 opacity-0 max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between border-b border-dark-700 pb-3">
      <h3 id="streamModalTitle" class="text-base font-bold text-white">Stream Collection</h3>
      <button type="button" onclick="closeStreamModal()" class="text-gray-400 hover:text-white p-1"><i class="ti ti-x"></i></button>
    </div>
    <div id="streamList" class="space-y-3 overflow-y-auto pr-1 flex-1"></div>
    <div id="streamModalEmptyState" class="hidden text-center py-8 text-gray-400"><p class="text-sm">No streams configured by this user</p></div>
  </div>
</div>

<!-- INCLUDE DECOUPLED MODULAR JS FILE WITH CACHE-BUSTING VERSIONING -->
<script src="/js/users-management.js?v=2.2.4" defer></script>
