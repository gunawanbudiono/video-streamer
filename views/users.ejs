<% layout('layout') -%>

<%
  const totalUserCount = (users && users.length) ? users.length : 0;
  const activeUserCount = (users && users.length) ? users.filter(u => u.status === 'active').length : 0;
  const suspendedUserCount = (users && users.length) ? users.filter(u => u.status === 'suspended').length : 0;
  const adminCount = (users && users.length) ? users.filter(u => (u.role || '').toLowerCase() === 'admin').length : 0;
  const memberCount = totalUserCount - adminCount;

  const totalStreamCount = (users && users.length) ? users.reduce((sum, u) => sum + (u.streamCount || 0), 0) : 0;
  const activeStreamCount = (users && users.length) ? users.reduce((sum, u) => sum + (u.activeStreamCount || 0), 0) : 0;
  const offlineStreamCount = Math.max(0, totalStreamCount - activeStreamCount);
%>

<div class="space-y-6">
  <!-- Page Header & Global Controls -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight">User Management</h1>
      <p class="text-xs text-gray-400 mt-1">Manage user accounts, disk quotas (GB), permissions, and security sessions</p>
    </div>
    <div class="flex items-center gap-2.5 flex-wrap">
      <button type="button" onclick="exportUsersCSV()" class="flex items-center gap-2 px-3.5 py-2.5 bg-dark-800 hover:bg-dark-700 text-gray-300 text-xs font-bold rounded-xl border border-dark-700 transition-all cursor-pointer shadow-md">
        <i class="ti ti-file-spreadsheet text-base text-emerald-400"></i>
        <span>Export CSV</span>
      </button>
      <button type="button" onclick="openActivityLogsModal()" class="flex items-center gap-2 px-4 py-2.5 bg-dark-700 hover:bg-dark-600 text-gray-200 text-xs font-bold rounded-xl border border-dark-600 transition-all cursor-pointer shadow-md">
        <i class="ti ti-history text-base text-blue-400"></i>
        <span>Activity Logs</span>
      </button>
      <button type="button" onclick="openCreateModal()" class="flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all cursor-pointer">
        <i class="ti ti-user-plus text-base"></i>
        <span>Create New User</span>
      </button>
    </div>
  </div>

  <!-- 3-Card Enterprise Dashboard Overview (User Accounts -> Storage Pool -> Streaming) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <!-- Card 1: User Accounts Overview (POSITION 1) -->
    <div class="bg-dark-800/80 border border-dark-700/80 rounded-2xl p-4 shadow-xl flex flex-col justify-between gap-3">
      <div class="flex items-center justify-between gap-2">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">User Accounts</p>
        <div class="w-8 h-8 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0">
          <i class="ti ti-users text-base"></i>
        </div>
      </div>

      <div class="space-y-1">
        <div class="text-xl font-extrabold text-white font-mono flex items-baseline gap-2">
          <%= totalUserCount %> <span class="text-xs text-gray-400 font-normal">Accounts Registered</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] font-mono">
          <span class="text-emerald-400 font-semibold flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> <%= activeUserCount %> Active
          </span>
          <span class="text-gray-600">•</span>
          <span class="<%= suspendedUserCount > 0 ? 'text-rose-400 font-semibold' : 'text-gray-500' %>">
            <%= suspendedUserCount %> Suspended
          </span>
        </div>
      </div>

      <div class="flex items-center justify-between text-[11px] text-gray-400 font-mono pt-1 border-t border-dark-700/60">
        <span><%= adminCount %> Admin</span>
        <span class="text-gray-500"><%= memberCount %> Member Accounts</span>
      </div>
    </div>

    <!-- Card 2: Global Storage Pool Overview (POSITION 2) -->
    <div class="bg-dark-800/80 border border-dark-700/80 rounded-2xl p-4 shadow-xl flex flex-col justify-between gap-3 relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Global Storage Pool</p>
          <span class="text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5 rounded font-mono font-bold">Unallocated</span>
        </div>
        <div class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
          <i class="ti ti-folder-plus text-base"></i>
        </div>
      </div>

      <div class="space-y-1.5">
        <div class="text-xl font-extrabold text-emerald-400 font-mono flex items-baseline gap-1.5">
          <%= (typeof systemStorage !== 'undefined' && systemStorage.unallocatedGB) ? systemStorage.unallocatedGB : 140 %> <span class="text-xs text-emerald-400 font-bold">GB Available</span>
        </div>
        <!-- Progress Bar (Allocated vs Total Capacity) -->
        <div class="w-full bg-dark-900 rounded-full h-1.5 overflow-hidden flex border border-dark-700/60" title="Member Quotas Allocated (<%= (typeof systemStorage !== 'undefined' && systemStorage.totalAllocatedGB) ? systemStorage.totalAllocatedGB : 350 %> GB / <%= (typeof systemStorage !== 'undefined' && systemStorage.totalDiskGB) ? systemStorage.totalDiskGB : 490 %> GB Total)">
          <div class="bg-blue-500 h-full rounded-full transition-all duration-500" style="width: <%= (typeof systemStorage !== 'undefined' && systemStorage.allocatedPercent) ? systemStorage.allocatedPercent : 71 %>%"></div>
        </div>
      </div>

      <div class="flex items-center justify-between text-[11px] text-gray-400 font-mono pt-1 border-t border-dark-700/60">
        <span><%= (typeof systemStorage !== 'undefined' && systemStorage.totalAllocatedGB) ? systemStorage.totalAllocatedGB : 350 %> GB Allocated</span>
        <span class="text-gray-500"><%= (typeof systemStorage !== 'undefined' && systemStorage.freeFormatted) ? systemStorage.freeFormatted : '345 GB' %> Physical Free</span>
      </div>
    </div>

    <!-- Card 3: Live Streaming Activity Overview (POSITION 3) -->
    <div class="bg-dark-800/80 border border-dark-700/80 rounded-2xl p-4 shadow-xl flex flex-col justify-between gap-3">
      <div class="flex items-center justify-between gap-2">
        <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Live Streaming Activity</p>
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 shrink-0">
          <i class="ti ti-broadcast text-base"></i>
        </div>
      </div>

      <div class="space-y-1">
        <div class="text-xl font-extrabold text-white font-mono flex items-baseline gap-2">
          <%= totalStreamCount %> <span class="text-xs text-gray-400 font-normal">Channels Configured</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] font-mono">
          <span class="<%= activeStreamCount > 0 ? 'text-emerald-400 font-bold' : 'text-gray-400' %> flex items-center gap-1">
            <% if (activeStreamCount > 0) { %>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <% } %>
            <%= activeStreamCount %> Online
          </span>
          <span class="text-gray-600">•</span>
          <span class="text-gray-500"><%= offlineStreamCount %> Offline</span>
        </div>
      </div>

      <div class="flex items-center justify-between text-[11px] text-gray-400 font-mono pt-1 border-t border-dark-700/60">
        <span class="text-gray-300">Multi-Channel RTMP</span>
        <span class="text-emerald-400 font-medium">Broadcaster v2.2</span>
      </div>
    </div>
  </div>

  <!-- Search & Filter Controls (With Count Badges) -->
  <div class="bg-dark-800/80 border border-dark-700/80 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="relative w-full md:w-96">
      <i class="ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
      <input type="text" id="searchInput" placeholder="Search users by name..." class="w-full bg-dark-900 border border-dark-700 rounded-xl pl-10 pr-4 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors" />
    </div>
    <div class="flex items-center gap-3 w-full md:w-auto">
      <select id="roleFilter" class="bg-dark-900 border border-dark-700 rounded-xl px-3 py-2 text-xs text-gray-300 focus:outline-none focus:border-blue-500">
        <option value="all">All Roles (<%= totalUserCount %>)</option>
        <option value="admin">Admin (<%= adminCount %>)</option>
        <option value="member">Member (<%= memberCount %>)</option>
      </select>
      <select id="statusFilter" class="bg-dark-900 border border-dark-700 rounded-xl px-3 py-2 text-xs text-gray-300 focus:outline-none focus:border-blue-500">
        <option value="all">All Status (<%= totalUserCount %>)</option>
        <option value="active">Active (<%= activeUserCount %>)</option>
        <option value="suspended">Suspended (<%= suspendedUserCount %>)</option>
      </select>
    </div>
  </div>

  <!-- Main User Table -->
  <div class="bg-dark-800/80 border border-dark-700/80 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-dark-700/80 bg-dark-900/40">
            <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">USER</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">ROLE</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">STATUS</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider w-64">VIDEO & STORAGE USAGE</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">STREAMING</th>
            <th class="px-6 py-4 text-xs font-bold text-gray-400 uppercase tracking-wider">ACTIVITY & DATES</th>
            <th class="px-6 py-4 text-right text-xs font-bold text-gray-400 uppercase tracking-wider">ACTIONS</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-dark-700/50">
          <% if (users && users.length > 0) { %>
            <% users.forEach(user => { %>
              <% const isCurrentUser = (user.id === req.session.userId || user.id === req.session.originalUserId); %>
              <tr class="hover:bg-dark-700/30 transition-colors user-row <%= isCurrentUser ? 'bg-blue-500/5 border-l-2 border-l-blue-500' : '' %>" data-username="<%= user.username.toLowerCase() %>" data-role="<%= user.role %>" data-status="<%= user.status %>">
                <!-- User Info -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-dark-700 border border-dark-600 flex items-center justify-center text-xs font-bold text-blue-400 shrink-0 overflow-hidden uppercase">
                      <% if (user.avatar_path) { %>
                        <img src="<%= user.avatar_path %>" alt="<%= user.username %>" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <span class="w-full h-full items-center justify-center text-xs font-bold text-blue-400 bg-dark-700 hidden"><%= user.username.substring(0, 2) %></span>
                      <% } else { %>
                        <span class="text-xs font-bold text-blue-400"><%= user.username.substring(0, 2) %></span>
                      <% } %>
                    </div>
                    <div>
                      <div class="font-bold text-sm text-white flex items-center gap-2">
                        <%= user.username %>
                        <% if (isCurrentUser) { %>
                          <span class="text-[10px] bg-blue-500/20 text-blue-400 border border-blue-500/30 px-1.5 py-0.5 rounded font-medium">You</span>
                        <% } %>
                      </div>
                      <div class="text-[11px] text-gray-500 font-mono">ID: <%= user.id %></div>
                    </div>
                  </div>
                </td>

                <!-- Role Badge -->
                <td class="px-6 py-4">
                  <span id="roleBadge-<%= user.id %>" class="px-2.5 py-1 text-xs font-semibold rounded-full <%= (user.role && user.role.toLowerCase() === 'admin') ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' : 'bg-blue-500/10 text-blue-400 border border-blue-500/20' %>">
                    <%= user.role ? (user.role.charAt(0).toUpperCase() + user.role.slice(1)) : 'Member' %>
                  </span>
                </td>

                <!-- Status Badge -->
                <td class="px-6 py-4">
                  <span id="statusBadge-<%= user.id %>" class="px-2.5 py-1 text-xs font-semibold rounded-full <%= user.status === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : (user.status === 'suspended' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20') %>">
                    <%= user.status ? (user.status.charAt(0).toUpperCase() + user.status.slice(1)) : 'Active' %>
                  </span>
                </td>

                <!-- Video & Storage Usage Bar + High Storage Warning Badge -->
                <td class="px-6 py-4 w-64">
                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-xs">
                      <button type="button" onclick="openUserVideosModal('<%= user.id %>', '<%= user.username %>')" class="text-gray-300 hover:text-blue-400 font-medium flex items-center gap-1 transition-colors group cursor-pointer" title="Click to inspect videos owned by this user">
                        <i class="ti ti-video text-gray-400 group-hover:text-blue-400"></i>
                        <span class="underline underline-offset-2 decoration-dark-600 group-hover:decoration-blue-400"><%= user.videoCount || 0 %> video</span>
                      </button>
                      <div class="flex items-center gap-1">
                        <% if (user.diskPercent > 85) { %>
                          <span class="text-[10px] bg-rose-500/20 text-rose-300 border border-rose-500/30 px-1 py-0.5 rounded font-mono font-bold flex items-center gap-0.5" title="Storage usage exceeds 85%">
                            <i class="ti ti-alert-triangle text-rose-400 text-xs"></i> High
                          </span>
                        <% } %>
                        <span id="diskPercentBadge-<%= user.id %>" data-used-bytes="<%= user.totalVideoSizeBytes || 0 %>" class="text-[10px] font-bold px-1.5 py-0.5 rounded <%= user.diskPercent > 90 ? 'bg-rose-500/20 text-rose-400 border border-rose-500/30' : (user.diskPercent > 75 ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' : 'bg-blue-500/20 text-blue-400 border border-blue-500/30') %>">
                          <%= user.diskPercent %>%
                        </span>
                      </div>
                    </div>
                    <span id="diskText-<%= user.id %>" class="text-xs text-gray-400 font-mono block">
                      <%= user.totalVideoSize || '0 B' %> / <%= user.diskLimitFormatted %>
                      <% if (user.hasCustomLimit) { %>
                        • <span class="text-emerald-400 font-medium"><%= user.freeSpaceFormatted %></span>
                      <% } else { %>
                        • <span class="text-purple-400 font-medium">System Pool</span>
                      <% } %>
                    </span>
                    <div class="w-full bg-dark-900 rounded-full h-1.5 overflow-hidden">
                      <div id="progressBar-<%= user.id %>" class="h-full <%= user.diskPercent > 90 ? 'bg-rose-500' : (user.diskPercent > 75 ? 'bg-amber-500' : 'bg-blue-500') %> transition-all duration-300" style="width: <%= user.diskPercent %>%"></div>
                    </div>
                  </div>
                </td>

                <!-- Streaming Stats -->
                <td class="px-6 py-4">
                  <div class="text-xs space-y-0.5">
                    <button type="button" onclick="openUserStreamsModal('<%= user.id %>', '<%= user.username %>')" class="text-gray-300 hover:text-blue-400 font-medium flex items-center gap-1 transition-colors group cursor-pointer" title="Click to inspect streams owned by this user">
                      <i class="ti ti-broadcast text-gray-400 group-hover:text-blue-400"></i>
                      <span class="underline underline-offset-2 decoration-dark-600 group-hover:decoration-blue-400"><%= user.streamCount || 0 %> stream</span>
                    </button>
                    <div class="<%= user.activeStreamCount > 0 ? 'text-emerald-400' : 'text-gray-500' %> font-medium text-[11px]">
                      <%= user.activeStreamCount || 0 %> online
                    </div>
                  </div>
                </td>

                <!-- Activity & Dates (Enriched Column) -->
                <td class="px-6 py-4">
                  <div class="text-xs space-y-1">
                    <div class="flex items-center gap-1.5 text-gray-300">
                      <i class="ti ti-calendar text-gray-500"></i>
                      <span>Created: <strong class="text-white font-mono"><%= new Date(user.created_at || user.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong></span>
                    </div>
                    <div class="flex items-center gap-1.5 text-[11px] font-mono">
                      <i class="ti ti-clock-play text-blue-400"></i>
                      <span class="text-gray-400">Last Active: </span>
                      <% if (isCurrentUser) { %>
                        <span class="text-emerald-400 font-bold flex items-center gap-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active Now
                        </span>
                      <% } else if (user.last_login || user.lastActive) { %>
                        <strong class="text-blue-400 font-semibold"><%= new Date(user.last_login || user.lastActive).toLocaleString('en-US', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></strong>
                      <% } else { %>
                        <span class="text-gray-500 italic">Never Logged In</span>
                      <% } %>
                    </div>
                  </div>
                </td>

                <!-- Action Buttons (With Direct Log Shortcut) -->
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <button type="button" 
                            onclick="openUserActivityLogsModal('<%= user.id %>', '<%= user.username %>')"
                            class="px-2.5 py-1.5 bg-dark-700/80 hover:bg-dark-600 text-blue-400 text-xs font-semibold rounded-lg border border-dark-600 transition-all flex items-center gap-1 cursor-pointer"
                            title="Inspect Activity Audit Logs for <%= user.username %>">
                      <i class="ti ti-history text-xs"></i> Log
                    </button>
                    <button type="button" 
                            data-action="edit"
                            data-user-id="<%= user.id %>"
                            data-username="<%= user.username %>"
                            data-role="<%= user.role %>"
                            data-status="<%= user.status %>"
                            data-avatar-path="<%= user.avatar_path || '' %>"
                            data-disk-limit="<%= user.disk_limit || 0 %>"
                            onclick="openEditUserModalFromBtn(this)" 
                            class="px-2.5 py-1.5 bg-dark-700/80 hover:bg-dark-600 text-gray-200 text-xs font-semibold rounded-lg border border-dark-600 transition-all flex items-center gap-1 cursor-pointer">
                      <i class="ti ti-info-circle"></i> Detail
                    </button>
                    <% if (!isCurrentUser) { %>
                      <button type="button" 
                              onclick="openImpersonateModal('<%= user.id %>', '<%= user.username %>', '<%= user.role %>')"
                              class="px-2.5 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 text-xs font-semibold rounded-lg border border-amber-500/20 transition-all flex items-center gap-1 cursor-pointer">
                        <i class="ti ti-user-check"></i> Impersonate
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="px-6 py-12 text-center text-gray-500 text-sm">No users found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ==================== MODALS ==================== -->

<!-- 1. CREATE USER MODAL (With Password Strength Meter) -->
<div id="createUserModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div id="createUserDialog" class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-4">
      <div>
        <h3 class="text-lg font-bold text-white">Create New User</h3>
        <p class="text-xs text-gray-400 mt-0.5">Add a new user account with custom avatar & disk quota (GB)</p>
      </div>
      <button type="button" onclick="closeCreateModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors"><i class="ti ti-x text-lg"></i></button>
    </div>

    <form id="createUserForm" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Profile Photo / Avatar Logo</label>
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-full bg-dark-900 border border-dark-700 overflow-hidden flex items-center justify-center shrink-0">
            <img id="createAvatarPreview" src="" class="w-full h-full object-cover hidden" />
            <span id="createAvatarInitials" class="text-xs font-bold text-blue-400">UP</span>
          </div>
          <input type="file" id="createAvatarInput" name="avatar" accept="image/*" onchange="previewAvatarImage(this, 'createAvatarPreview', 'createAvatarInitials')" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3 py-1.5 text-xs text-gray-300 file:mr-3 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Username</label>
        <input type="text" name="username" required placeholder="Enter username..." class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Password</label>
        <div class="relative">
          <input type="password" id="createPassword" name="password" required oninput="evaluatePasswordStrength('createPassword', 'createPassMeterBar', 'createPassMeterText')" placeholder="Enter password..." class="w-full bg-dark-900 border border-dark-700 rounded-xl pl-3.5 pr-10 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
          <button type="button" onclick="togglePasswordVisibility('createPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white p-1">
            <i class="ti ti-eye"></i>
          </button>
        </div>
        <!-- Password Strength Meter -->
        <div class="mt-1.5 space-y-1">
          <div class="w-full bg-dark-950 rounded-full h-1 overflow-hidden">
            <div id="createPassMeterBar" class="h-full w-0 bg-rose-500 transition-all duration-300"></div>
          </div>
          <span id="createPassMeterText" class="text-[10px] font-mono text-gray-500 block">Password Strength: Enter characters</span>
        </div>
      </div>

      <!-- Server Storage Status Card -->
      <div class="bg-dark-900/90 border border-dark-700/80 rounded-xl p-3.5 space-y-2 mb-3">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-gray-200 flex items-center gap-1.5">
            <i class="ti ti-server text-blue-400"></i> Server Storage Overview
          </span>
          <span class="font-mono text-gray-400">
            <strong class="text-emerald-400"><%= (typeof systemStorage !== 'undefined' && systemStorage.freeFormatted) ? systemStorage.freeFormatted : '345 GB' %> Free</strong> / <%= (typeof systemStorage !== 'undefined' && systemStorage.totalFormatted) ? systemStorage.totalFormatted : '490 GB' %> Total
          </span>
        </div>
        <div class="w-full bg-dark-950 rounded-full h-2 overflow-hidden flex">
          <div class="bg-blue-500 h-full transition-all duration-500" style="width: <%= (typeof systemStorage !== 'undefined' && systemStorage.allocatedPercent) ? systemStorage.allocatedPercent : 71 %>%" title="Allocated to Member Users"></div>
        </div>
        <div class="flex items-center justify-between text-[11px] font-mono pt-0.5">
          <span class="text-gray-400">Allocated (Member Users): <strong class="text-blue-400"><%= (typeof systemStorage !== 'undefined' && systemStorage.totalAllocatedGB) ? systemStorage.totalAllocatedGB : 350 %> GB</strong></span>
          <span class="text-emerald-400 font-bold">Unallocated Pool: <%= (typeof systemStorage !== 'undefined' && systemStorage.unallocatedGB) ? systemStorage.unallocatedGB : 140 %> GB Available</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Role</label>
          <select name="role" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="member" selected>Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Disk Quota (GB)</label>
          <input type="number" id="createDiskLimitGB" name="diskLimitGB" min="0" placeholder="50" value="50" oninput="updateQuotaAllocationGuidance(this.value, 'create')" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500 font-medium" />
        </div>
      </div>

      <p id="createQuotaGuideText" class="text-[11px] text-emerald-400 mt-1 font-medium flex items-center gap-1">
        <i class="ti ti-check text-xs"></i>
        <span>Allocating 50 GB (Remaining Unallocated Pool: <%= (typeof systemStorage !== 'undefined' && systemStorage.unallocatedGB ? systemStorage.unallocatedGB - 50 : 90) %> GB)</span>
      </p>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-dark-700">
        <button type="button" onclick="closeCreateModal()" class="px-4 py-2.5 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="submit" id="createUserSubmitBtn" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all cursor-pointer">Create User</button>
      </div>
    </form>
  </div>
</div>

<!-- 2. USER DETAILS & SETTINGS (EDIT) MODAL (With Session Revocation) -->
<div id="editModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div id="editDialog" class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-4">
      <div>
        <h3 class="text-lg font-bold text-white">User Details & Settings</h3>
        <p class="text-xs text-gray-400 mt-0.5">Edit user profile, avatar logo, password, or disk quota (GB)</p>
      </div>
      <button type="button" onclick="closeEditModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors"><i class="ti ti-x text-lg"></i></button>
    </div>

    <form id="editUserForm" enctype="multipart/form-data" onsubmit="return handleEditUserSubmit(event)" class="space-y-4">
      <input type="hidden" id="editUserId" name="userId" />

      <!-- Profile Avatar File Upload -->
      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Profile Photo / Avatar Logo</label>
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-full bg-dark-900 border border-dark-700 overflow-hidden flex items-center justify-center shrink-0">
            <img id="editAvatarPreview" src="" class="w-full h-full object-cover hidden" />
            <span id="editAvatarInitials" class="text-xs font-bold text-blue-400 uppercase">US</span>
          </div>
          <input type="file" id="editAvatarInput" name="avatar" accept="image/*" onchange="previewAvatarImage(this, 'editAvatarPreview', 'editAvatarInitials')" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3 py-1.5 text-xs text-gray-300 file:mr-3 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Username</label>
        <input type="text" id="editUsername" name="username" required class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">New Password <span class="text-gray-500 font-normal">(Leave blank to keep current)</span></label>
        <div class="relative">
          <input type="password" id="editPassword" name="password" oninput="evaluatePasswordStrength('editPassword', 'editPassMeterBar', 'editPassMeterText')" placeholder="Enter new password..." class="w-full bg-dark-900 border border-dark-700 rounded-xl pl-3.5 pr-10 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
          <button type="button" onclick="togglePasswordVisibility('editPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white p-1">
            <i class="ti ti-eye"></i>
          </button>
        </div>
        <!-- Password Strength Meter -->
        <div class="mt-1.5 space-y-1">
          <div class="w-full bg-dark-950 rounded-full h-1 overflow-hidden">
            <div id="editPassMeterBar" class="h-full w-0 bg-rose-500 transition-all duration-300"></div>
          </div>
          <span id="editPassMeterText" class="text-[10px] font-mono text-gray-500 block">Password Strength: Optional</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Role</label>
          <select id="editRole" name="role" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="member">Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1.5">Status</label>
          <select id="editStatus" name="status" class="w-full bg-dark-900 border border-dark-700 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
            <option value="active">Active</option>
            <option value="suspended">Suspended</option>
          </select>
        </div>
      </div>

      <!-- Server Storage Status Card -->
      <div class="bg-dark-900/90 border border-dark-700/80 rounded-xl p-3.5 space-y-2 mb-3">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-gray-200 flex items-center gap-1.5">
            <i class="ti ti-server text-blue-400"></i> Server Storage Overview
          </span>
          <span class="font-mono text-gray-400">
            <strong class="text-emerald-400"><%= (typeof systemStorage !== 'undefined' && systemStorage.freeFormatted) ? systemStorage.freeFormatted : '345 GB' %> Free</strong> / <%= (typeof systemStorage !== 'undefined' && systemStorage.totalFormatted) ? systemStorage.totalFormatted : '490 GB' %> Total
          </span>
        </div>
        <div class="w-full bg-dark-950 rounded-full h-2 overflow-hidden flex">
          <div class="bg-blue-500 h-full transition-all duration-500" style="width: <%= (typeof systemStorage !== 'undefined' && systemStorage.allocatedPercent) ? systemStorage.allocatedPercent : 71 %>%" title="Allocated to Member Users"></div>
        </div>
        <div class="flex items-center justify-between text-[11px] font-mono pt-0.5">
          <span class="text-gray-400">Allocated (Member Users): <strong class="text-blue-400"><%= (typeof systemStorage !== 'undefined' && systemStorage.totalAllocatedGB) ? systemStorage.totalAllocatedGB : 350 %> GB</strong></span>
          <span class="text-emerald-400 font-bold">Unallocated Pool: <%= (typeof systemStorage !== 'undefined' && systemStorage.unallocatedGB) ? systemStorage.unallocatedGB : 140 %> GB Available</span>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-400 mb-1.5">Disk Quota Limit (GB) <span class="text-gray-500 font-normal">(e.g. 50 for 50 GB, 0 = Unlimited)</span></label>
        <div class="relative">
          <input type="number" id="editDiskLimitGB" name="diskLimitGB" min="0" placeholder="50" oninput="updateQuotaAllocationGuidance(this.value, 'edit')" class="w-full bg-dark-900 border border-dark-700 rounded-xl pl-3.5 pr-12 py-2 text-sm text-white focus:outline-none focus:border-blue-500 font-medium" />
          <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs font-bold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-md border border-blue-500/20">GB</span>
        </div>
        <p id="editQuotaGuideText" class="text-[11px] text-emerald-400 mt-1.5 font-medium flex items-center gap-1">
          <i class="ti ti-info-circle text-xs"></i>
          <span>Quota limit setting in Gigabytes (GB)</span>
        </p>
      </div>

      <!-- Security & Account Management (Revoke Sessions / Suspend / Delete) -->
      <div class="bg-dark-900/60 border border-dark-700/60 rounded-xl p-3.5 space-y-2.5">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold text-gray-300">Security & Session Control</p>
            <p class="text-[11px] text-gray-500">Revoke active login sessions across devices</p>
          </div>
          <button type="button" onclick="handleRevokeCurrentModalUserSessions()" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 text-xs font-bold rounded-lg border border-amber-500/20 transition-all flex items-center gap-1 cursor-pointer">
            <i class="ti ti-logout text-sm"></i>
            <span>Revoke Sessions</span>
          </button>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-dark-700/60">
          <div>
            <p class="text-xs font-bold text-gray-300">Account Status</p>
            <p class="text-[11px] text-gray-500">Suspend access or delete user</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" id="suspendUserBtn" onclick="handleToggleSuspendUser()" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 text-xs font-bold rounded-lg border border-amber-500/20 transition-all flex items-center gap-1 cursor-pointer">
              <i class="ti ti-user-off text-sm"></i>
              <span id="suspendBtnLabel">Suspend</span>
            </button>
            <button type="button" id="deleteUserBtn" onclick="handleDeleteUserFromEditModal()" class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-xs font-bold rounded-lg border border-rose-500/20 transition-all flex items-center gap-1 cursor-pointer">
              <i class="ti ti-trash text-sm"></i>
              <span>Delete</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="flex items-center justify-end gap-3 pt-3 border-t border-dark-700">
        <button type="button" onclick="closeEditModal()" class="px-4 py-2.5 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="button" id="saveEditUserBtn" onclick="handleEditUserSubmit(event)" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all cursor-pointer">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- 3. IMPERSONATE CONFIRMATION MODAL -->
<div id="impersonateModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div id="impersonateDialog" class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-5 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
          <i class="ti ti-user-check text-lg"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Confirm Impersonation</h3>
          <p class="text-xs text-gray-400">Switch session context to another user</p>
        </div>
      </div>
      <button type="button" onclick="closeImpersonateModal()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-dark-700 transition-colors"><i class="ti ti-x text-lg"></i></button>
    </div>

    <div class="space-y-3 text-xs text-gray-300">
      <p class="leading-relaxed">
        You are about to log in as user <strong id="impersonateTargetName" class="text-amber-400 font-bold"></strong> (<span id="impersonateTargetRole" class="capitalize"></span>).
      </p>
      <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-3.5 text-amber-300 space-y-1">
        <p class="font-bold flex items-center gap-1.5">
          <i class="ti ti-alert-circle text-sm"></i> Session Information
        </p>
        <p class="text-[11px] text-amber-300/80 leading-relaxed">
          Your current admin session credentials will be saved safely. You can return to your admin account at any time by clicking "Stop Impersonating" at the top banner.
        </p>
      </div>
    </div>

    <form id="impersonateForm" method="POST" action="">
      <div class="flex items-center justify-end gap-3 pt-3 border-t border-dark-700">
        <button type="button" onclick="closeImpersonateModal()" class="px-4 py-2.5 bg-dark-700 hover:bg-dark-600 text-gray-300 text-xs font-semibold rounded-xl transition-all cursor-pointer">Cancel</button>
        <button type="submit" class="px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-black text-xs font-bold rounded-xl shadow-lg shadow-amber-500/20 transition-all cursor-pointer flex items-center gap-1.5">
          <i class="ti ti-user-check text-sm"></i>
          <span>Confirm & Login</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 4. USER VIDEOS DETAIL INSPECTION MODAL -->
<div id="userVideosModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all">
  <div id="userVideosDialog" class="bg-dark-800 border border-dark-700 rounded-2xl shadow-2xl max-w-2xl w-full p-6 space-y-4 transform transition-all scale-95 opacity-0">
    <div class="flex items-center justify-between border-b border-dark-700 pb-3.5">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
          <i class="ti ti-video text-base"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Videos Owned by <span id="videosModalUsername" class="text-blue-400"></span></h3>
          <p class="text-xs text-gray-400">List of video media files uploaded by this account</p>
