# ── ClickHouse ──────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=default

# ── Server ──────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# ── CMS API Keys (generate strong passwords) ───────
# Format: API_KEY_<CMS_ID>=<key>
API_KEY_cms_demo=change-me-to-a-strong-key

# ── CMS ClickHouse Credentials ─────────────────────
# Format: CH_USER_<CMS_ID>=<user>, CH_PASS_<CMS_ID>=<pass>
# Read users (for API queries)
CH_USER_cms_demo=user_cms_demo
CH_PASS_cms_demo=change-me

# Ingest users (for ETL workers)
CH_INGEST_USER_cms_demo=ingest_cms_demo
CH_INGEST_PASS_cms_demo=change-me

# ── Admin Master Key ────────────────────────────────
ADMIN_MASTER_KEY=change-me-to-a-strong-admin-key
